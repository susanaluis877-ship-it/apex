<?xml version="1.0" encoding="utf-8"?>
<!--
  事件只用来唤醒引擎，页面内容每轮主动抓取。
  flagReportViewIds：节点带资源 id；flagRetrieveInteractiveWindows：能拿到 Dialog/PopupWindow 等所有窗口。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged|typeViewScrolled|typeViewTextChanged|typeViewClicked|typeViewFocused|typeViewSelected"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/apex_accessibility_description"
    android:notificationTimeout="50" />
